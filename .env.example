# LLM Provider Configuration ('gemini' or 'openai')
LLM_PROVIDER=gemini

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection:
# Curator: Fast & cost-effective model for relevance scoring
CURATOR_MODEL=gemini-2.0-flash
# Analyst: Deep reasoning model for technical architectures & benchmarks
ANALYST_MODEL=gemini-2.0-flash

# If using OpenAI:
# CURATOR_MODEL=gpt-4o-mini
# ANALYST_MODEL=gpt-4o

# Telegram Broadcaster (Opsiyonel - Günlük mobil bülten bildirimi için)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=@your_channel_name_or_chat_id

# Localization & Preferences
REPORT_LANGUAGE=tr  # 'tr' (Turkish) or 'en' (English)

# Ingestion Constraints
MAX_HOURS_OLD=24
MAX_ARTICLES_PER_SOURCE=8

# Curation Thresholds
MIN_RELEVANCE_SCORE=7
MAX_CURATED_ARTICLES=8
